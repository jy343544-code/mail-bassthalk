# Supabase project settings (browser-safe)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side values used by TanStack Start server functions
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# REQUIRED for trusted server-side admin operations. Obtain from Supabase/Lovable Cloud.
# Add this only to Vercel Environment Variables as an encrypted server-only secret.
# Never prefix it with VITE_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
